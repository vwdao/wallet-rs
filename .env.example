# ── Wallet Environment Template ─────────────────────────────────────────
# Copy to .env and fill in values before deploying.
# Usage: cp .env.example .env && vim .env

# Container image
WALLET_IMAGE=wallet:latest
REGISTRY=ghcr.io/yourorg

# Postgres
POSTGRES_PASSWORD=wallet-pass-change-me

# JWT (app gateway)
JWT_SECRET=change-me-to-random-64-chars
JWT_ISSUER=viva-wallet

# JWT (admin gateway)
ADMIN_JWT_SECRET=change-me-to-random-64-chars
ADMIN_JWT_ISSUER=viva-wallet-admin

# Chain gateway admin auth (optional — empty disables that credential)
GATEWAY_ADMIN_USERNAME=admin
GATEWAY_ADMIN_PASSWORD=change-me
GATEWAY_ADMIN_KEY=change-me

# DEX API keys (optional — leave empty to disable)
ONEINCH_API_KEY=
OKX_API_KEY=
OKX_SECRET=
OKX_PASSPHRASE=
METAPATH_API_KEY=

# RPC endpoints (override defaults)
# ETH_RPC_URL=https://eth.llamarpc.com
# SOL_RPC_URL=https://api.mainnet-beta.solana.com
# TRON_RPC_URL=https://api.trongrid.io
# BTC_RPC_URL=https://blockstream.info/api
# DOGE_RPC_URL=http://127.0.0.1:8545/rpc/doge/gw_5a6ce3f0795246bc9d5b938e5af8a399
